{
  "name": "@tmielsch/dsh-projectos",
  "version": "0.3.0",
  "description": "projectOS for DeepSeek Harness: a department manager page that shows the agent teams of a workspace as departments and work groups, with a worker-oriented kanban board.",
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "agents",
    "patches",
    "rollen",
    "dsh-links.json",
    "scripts/agents-block.mjs",
    "scripts/link-dsh.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "node scripts/build-model.mjs && node --test test/*.test.mjs",
    "agents": "node scripts/agents-block.mjs",
    "links": "node scripts/link-dsh.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.2.0-rc.2",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent-team",
    "project-manager"
  ],
  "license": "MIT",
  "main": "./lib/index.js",
  "dependencies": {
    "zod": "^4.4.3"
  }
}
